<?xml version="1.0"?>
<ruleset name="Lions Theme">
  <description>WordPress Coding Standards for the Lions International theme.</description>

  <file>.</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>assets/*</exclude-pattern>
  <exclude-pattern>.phpstan-cache/*</exclude-pattern>
  <exclude-pattern>languages/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="parallel" value="8"/>
  <arg name="cache" value=".phpcs-cache"/>
  <ini name="memory_limit" value="1G"/>

  <config name="minimum_wp_version" value="6.6"/>
  <config name="testVersion" value="8.2-"/>

  <rule ref="WordPress">
    <!-- PSR-4 class files (src/Foo.php) instead of class-foo.php -->
    <exclude name="WordPress.Files.FileName"/>
    <!-- Twig handles output; PHP returns data. Allow short array syntax and modern PHP. -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    <!-- Timber uses snake_case method names on its objects; we follow PSR-4 camelCase inside src. -->
    <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
    <!-- Timber::render() escapes/handles output; the theme escapes inside Twig. -->
    <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="lions-theme"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="lions"/>
        <element value="Lions"/>
      </property>
    </properties>
  </rule>

  <rule ref="PHPCompatibilityWP"/>
</ruleset>
