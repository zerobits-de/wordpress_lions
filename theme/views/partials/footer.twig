{#
  Compact site footer: social profiles on the left, contact email and legal
  links on the right.
#}
<footer class="site-footer">
  <div class="container site-footer__inner">
    {% if site.social %}
      {% include 'components/social-links.twig' with { links: site.social, class: 'site-footer__social' } only %}
    {% endif %}

    <div class="site-footer__meta">
      {% if site.contact.email %}
        <address class="site-footer__address">
          <a href="mailto:{{ site.contact.email|e('html_attr') }}">{{ site.contact.email|e }}</a>
        </address>
      {% endif %}

      {% if menus.legal %}
        {% include 'components/navigation.twig' with {
          menu: menus.legal,
          class: 'legal-nav',
          aria_label: __('Legal', 'lions-theme'),
          depth: 1
        } only %}
      {% endif %}
    </div>
  </div>
</footer>
