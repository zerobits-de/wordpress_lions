{% extends 'base.twig' %}

{#
  Homepage. Section data is prepared by FrontPageController / FrontPageContent.
#}

{% block content %}
  {% include 'sections/hero.twig' with { hero: hero } only %}

  {% include 'sections/feature.twig' with {
    id: 'intro',
    title: intro.title,
    body: intro.body,
    image: intro.image,
    action: intro.action,
    heading_level: 2
  } only %}

  {% include 'sections/statistics.twig' with {
    id: 'impact',
    title: statistics.title,
    items: statistics.items
  } only %}

  {# One lockup per post in the category chosen under Customizer > Lions International. #}
  {% for block in feature_posts %}
    {% include 'sections/feature.twig' with {
      id: block.id,
      title: block.title,
      body: block.body,
      image: block.image,
      action: block.action,
      reverse: block.reverse,
      heading_level: 2
    } only %}
  {% endfor %}

  {% include 'sections/stories.twig' with {
    id: 'stories',
    title: __('Latest stories', 'lions-theme'),
    posts: stories,
    archive_url: fn('get_post_type_archive_link', 'post')
  } only %}

  {% include 'sections/cta.twig' with { cta: cta } only %}
{% endblock %}
