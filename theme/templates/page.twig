{% extends 'base.twig' %}

{% block content %}
  {% include 'partials/page-header.twig' with {
    title: post.title,
    breadcrumbs: breadcrumbs,
    image: post.thumbnail
  } only %}

  <div class="container">
    <div class="page-layout">
      <article class="panel prose" id="post-{{ post.ID }}">
        {{ post.content }}
      </article>
    </div>
  </div>
{% endblock %}
