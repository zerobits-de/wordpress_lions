# Copy to .env and adjust. Never commit .env.

# --- Ports -----------------------------------------------------------------
# WordPress is exposed on http://localhost:${WORDPRESS_PORT}
WORDPRESS_PORT=8080

# --- Database (internal to the Docker network; not exposed to the host) -----
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# --- WordPress -------------------------------------------------------------
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# Used by `make install` (WP-CLI) to complete the WordPress setup non-interactively.
WORDPRESS_SITE_TITLE="Lions International"
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.com
WORDPRESS_LOCALE=en_US
